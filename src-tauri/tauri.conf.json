{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellune",
  "version": "0.1.0",
  "identifier": "com.stellune.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "星迹 · Stellune",
        "width": 960,
        "height": 640,
        "minWidth": 960,
        "minHeight": 640,
        "maxWidth": 960,
        "maxHeight": 640,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
